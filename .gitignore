# Docker bind-mount surface — all host-side state lives here.
# Everything inside is gitignored; the folder ships with just README + .gitkeep
# and `pnpm setup` populates it with config.json + .env.
docker/*
!docker/.gitkeep
!docker/README.md

# OS
.DS_Store
Thumbs.db
.aider*
