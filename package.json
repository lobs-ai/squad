{
  "name": "squad",
  "version": "0.0.0",
  "private": true,
  "description": "A self-hostable agent platform built for usability and subagents.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @squad/gateway dev",
    "setup": "node scripts/setup.mjs",
    "start": "scripts/start.sh",
    "start:docker": "scripts/start.sh --docker",
    "start:local": "scripts/start.sh --local",
    "stop": "scripts/stop.sh",
    "status": "scripts/status.sh",
    "install:squad": "scripts/install.sh",
    "uninstall:squad": "scripts/install.sh --uninstall",
    "test": "pnpm -r test",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r clean",
    "verify": "pnpm lint && pnpm build && pnpm typecheck && pnpm test:coverage"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^9.10.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.5.0",
    "vitest": "^4.1.5"
  }
}
