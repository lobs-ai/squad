# Copy to ./docker/.env (or run `pnpm setup` to generate it interactively).
# This file is the env source loaded by both docker-compose and the local
# launcher. Keep it out of git — it holds secrets.

# --- Required ---
ANTHROPIC_API_KEY=

# Bearer token for the dashboard + any first-party clients. Treat as a password.
# `pnpm setup` generates a strong random one; rotate it any time by editing here.
SQUAD_DASHBOARD_TOKEN=dev-dashboard-token

# --- Optional LLM providers ---
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=

# --- Optional Discord channel ---
# DISCORD_BOT_TOKEN=
# SQUAD_DISCORD_TOKEN=
